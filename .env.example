# Jourvance (Spoke Environment)
APP_ID=jourvance
HUB_URL=https://zeluslabs.dev
HUB_API_KEY=
PORT=3000
# Optional. Signs unsubscribe links. When empty, the hub API key is used.
# MAIL_LINK_SECRET=
# Optional. At least 16 characters, and no line breaks. Together with a public
# https PUBLIC_BASE_URL, this is what lets the hub post opens, clicks, bounces,
# and complaints to POST /api/email/provider-event. Until both are set, opens stay blank.
# MAIL_EVENT_SECRET=
# Required before POST /api/internal/cron/drips exists. There is no default.
# INTERNAL_CRON_SECRET=
# Public https origin the hub can reach. Used in unsubscribe links, as the checkout
# return address when the browser sends no Origin, and as the mail-event callback.
# Example: https://jourvance.example
# Localhost is not enough. Until this is a public https origin, opens stay blank.
# PUBLIC_BASE_URL=
# Growth Pro checkout. Unset: POST /api/billing/checkout returns 503 and charges nothing.
# STRIPE_SECRET_KEY=
# Signs POST /api/billing/webhook. Unset: the webhook returns 503 and changes no plan.
# STRIPE_WEBHOOK_SECRET=

# Optional. The defaults below are what server.mjs uses when these are unset.
# FIREBASE_PROJECT_ID=gen-lang-client-0527980301   # ID tokens must name this project (aud + iss)
# OPERATOR_EMAIL=tlm@tarrenmunoz.com               # the one VERIFIED email that may open /api/admin/*
# AI_COPY_PER_HOUR=30                              # per-user hub AI calls; past it, labelled templates

# Signing keys. Each falls back to HUB_API_KEY, and with neither set the server mints a key
# for the process and says so at boot: links and tokens signed then do not survive a restart.
# No literal fallback is shipped in the source.
# MAIL_LINK_SECRET=        signs unsubscribe and tracked mail links (MAIL_LINK_OLD_SECRETS, comma separated, keeps old links verifying through a rotation)
# SESSION_SECRET=          derives the DNS token a merchant places to verify a custom domain

# Proxy trust (server/proxy-trust.mjs). The socket peer and at most ONE Cloudflare hop are
# trusted by address; nothing is trusted by count. Both optional, comma separated CIDRs.
# TRUSTED_PROXY_CIDRS=     a non-Cloudflare internal proxy on the load balancer's side; walked without ending the walk. Never a Cloudflare range
# CLOUDFLARE_EXTRA_CIDRS=  a Cloudflare range newer than the built-in tables; ends the walk like any Cloudflare hop
